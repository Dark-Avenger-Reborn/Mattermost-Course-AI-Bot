# ─── Mattermost ───────────────────────────────────────────────
MATTERMOST_URL=https://your-mattermost-server.com
MATTERMOST_TOKEN=your-bot-token-here
MATTERMOST_BOT_USERNAME=course-bot

# ─── UB AI (LiteLLM) ──────────────────────────────────────────
UB_AI_BASE_URL=https://ai.buffalo.edu/api/v1
UB_AI_API_KEY=your-ub-ai-key-here

# Optional: Use local embeddings instead of UB AI for embedding generation
LOCAL_EMBEDDINGS=true
LOCAL_EMBED_MODEL=all-MiniLM-L6-v2

# ─── Models ───────────────────────────────────────────────────
CHAT_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ─── Course Identity ──────────────────────────────────────────
COURSE_NAME=CSE 101: Introduction to Computer Science
COURSE_DESCRIPTION=Introductory computer science course covering algorithms, data structures, and programming fundamentals.
INSTRUCTOR_NAME=Professor Smith

# ─── Channel Context ──────────────────────────────────────────
# Comma-separated Mattermost channel IDs the bot should read for context.
# The bot must be a member of all listed channels.
# Get channel IDs from: Mattermost > Channel Settings > View Info
CONTEXT_CHANNEL_IDS=channel_id_1,channel_id_2,channel_id_3

# ─── Admin Users ──────────────────────────────────────────────
# Comma-separated Mattermost usernames allowed to run admin commands
ADMIN_USERNAMES=your_username,instructor_username

# ─── RAG Settings ─────────────────────────────────────────────
CHROMA_PATH=./chroma_db
COURSE_MATERIAL_PATH=./course_material
RAG_TOP_K=10          # Retrieve this many chunks before reranking
RAG_RERANK_TOP_N=4    # Keep this many after reranking

# ─── Channel Fetch Settings ───────────────────────────────────
CHANNEL_FETCH_LIMIT=99999   # How many recent posts to pull per channel

# ─── Image Input (Screenshots/Attachments) ───────────────────
MM_ENABLE_IMAGE_INPUT=true      # Allow attached images to be sent to multimodal models
MM_MAX_IMAGES_PER_MESSAGE=3     # Max image attachments to include from one message
MM_MAX_IMAGE_BYTES=5000000      # Per-image size limit in bytes (~5 MB)
